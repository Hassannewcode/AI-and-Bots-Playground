{
  "version": 2,
  "public": true,
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/(.*\\.(?:tsx|ts|jsx))",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript" }
      ]
    }
  ]
}
